# ---- Required: writing the copy ----
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5
CLAUDE_MODEL=claude-opus-5

# ---- Optional: generating images ----
# Claude does not make images, so this needs a separate account.
# Google Gemini is the default and tends to be stronger at photographic realism.
# Get a key at https://aistudio.google.com/apikey (it starts with AIza).
GEMINI_API_KEY=

# OpenAI works too. Fill this in instead and set IMAGE_PROVIDER=openai.
OPENAI_API_KEY=

# Leave blank to auto-detect from whichever key above is filled in.
IMAGE_PROVIDER=

# Overrides, only if you need them.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image,gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high

PORT=3000

# Set to 1 to try the interface without any API keys (canned copy, no image generation)
MOCK_AI=0
