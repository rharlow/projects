# Required for copy generation
ANTHROPIC_API_KEY=sk-ant-...
# Optional, defaults to claude-opus-5
CLAUDE_MODEL=claude-opus-5

# Optional. Enables the "Generate image" button. Leave blank to use uploads only.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high

PORT=3000

# Set to 1 to try the interface without any API keys (canned copy, no image generation)
MOCK_AI=0
