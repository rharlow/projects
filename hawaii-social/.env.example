# Required: writing the copy. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5
CLAUDE_MODEL=claude-opus-5

PORT=3000

# Only for hosting online. Leave both blank on your own computer.
# TEAM_PASSWORD is the one password the course staff type to get in.
# DATA_DIR is where the host's permanent disk is mounted, for example /data.
TEAM_PASSWORD=
DATA_DIR=

# Set to 1 to try the interface without an API key (canned copy)
MOCK_AI=0
